// Cloudflare Workers static site for dashboard.vinven.net. Workers Builds runs
// `npm install && npm run build`, then `npx wrangler deploy`, with web/ as the path.
{
  "name": "corefit-dashboard",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
